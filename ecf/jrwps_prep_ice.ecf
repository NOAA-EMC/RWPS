#PBS -S /bin/bash
#PBS -q dev
#PBS -l walltime=00:59:00
#PBS -A GLWU-DEV
#PBS -N RWPS.PreProc.ice
#PBS -j oe
#PBS -l select=1:ncpus=16:mem=64GB



############################################################
# Load modules
############################################################
source ${HOMErwps}/versions/run.${MACHINE_ID}.ver

#modules for esmf
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load hdf5-C/${hdf5_C_ver}
module load netcdf-C/${netcdf_C_ver}
module load esmf-C/${esmf_C_ver}
module load ve/hafs/${ve_hafs_ver}

#modules for wgrib2
module load intel-oneapi/${intel_oneapi_ver}
module load wgrib2/${wgrib2_ver}

module load prod_util/${prod_util_ver}

module list 

############################################################
# set env variables according to nws-hpc-standards
############################################################
#TODO: OPSROOT=/lfs/$FS/ops/$envir
OPSROOT=/lfs/h2/emc/ptmp/$USER
envir="test"
export job=rwps.$PDY.$cyc.$meshID
export jobid=$job.$PBS_JOBID
export DATAROOT=$OPSROOT/tmp
export COMROOT=$OPSROOT/com
export KEEPDATA=YES

############################################################
# run j-job
############################################################
${HOMErwps}/jobs/JRWPS_PREP_ICE
